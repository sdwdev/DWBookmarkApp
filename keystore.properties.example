# 릴리스 서명 설정 템플릿
#
# 사용법:
#   1. 이 파일을 같은 폴더에 keystore.properties 라는 이름으로 복사한다.
#   2. 아래 값을 실제 값으로 채운다.
#   3. ./gradlew bundleRelease  ->  서명된 AAB 생성
#
# keystore.properties 는 .gitignore 에 등록되어 커밋되지 않는다.
# 키스토어 파일은 프로젝트 폴더 밖에 두고 별도로 백업할 것.
#
# storeFile 은 프로젝트 루트 기준 상대경로 또는 절대경로.
# 윈도우 경로는 역슬래시 대신 슬래시(/)를 쓴다.
#
# storeType 은 키스토어 형식. 확장자가 없거나 .p12 면 PKCS12, .jks 면 JKS.
# 생략하면 PKCS12 로 간주한다.
#
# storePassword 나 keyAlias 를 비워 두면 서명을 건너뛰고
# 서명되지 않은 산출물이 만들어진다 (빌드는 실패하지 않는다).

storeFile=../my-release-key
storeType=PKCS12
keyAlias=key0
storePassword=
keyPassword=
