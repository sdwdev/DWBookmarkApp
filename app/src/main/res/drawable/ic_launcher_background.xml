<?xml version="1.0" encoding="utf-8"?>
<!--
    적응형 아이콘 배경. 전경(흰 '줍' 글자)과 대비되는 민트 그라디언트.
    런처가 기기마다 다른 모양으로 잘라내므로 무늬 없이 단순하게 둔다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#2BD6C4"
        android:endColor="#0E939B"
        android:type="linear" />
</shape>
