<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar: Toolbar를 코드로 직접 설정하기 위해 사용 -->
    <style name="Theme.DWBookmarkApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>

        <!--
            Edge-to-edge(Android 15+ 강제) 대응.
            시스템 바는 투명하게 두고, 실제 여백/배경은 MainActivity 의 인셋 처리에서 담당한다.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!--
        공유 인텐트 수신용 투명 테마.
        ShareReceiverActivity 는 화면을 그리지 않고 저장만 한 뒤 종료하므로
        사용자가 보던 앱이 그대로 보이도록 창을 투명하게 만든다.
    -->
    <style name="Theme.DWBookmarkApp.Transparent" parent="Theme.DWBookmarkApp">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
